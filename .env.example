# Copie este arquivo para .env e preencha com seus dados (NUNCA suba o .env no GitHub)

# =============================================================================
# 1. SUPABASE (Auth + Banco de Dados PostgreSQL)
# =============================================================================
# Encontre em: Supabase Dashboard > Project Settings > Data API / API Keys
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-publica-anon-ou-publishable

# Opcional: necessario apenas se seu projeto Supabase usar assinatura JWT legada (HS256)
# Projetos novos usam chaves assimetricas (ES256 via JWKS) automaticamente.
# SUPABASE_JWT_SECRET=

# Connection string PostgreSQL do Supabase (use o Transaction Pooler - porta 6543 - na Vercel!)
# Encontre em: Supabase Dashboard > Connect > Transaction pooler
# Exemplo: postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./financas.db

# =============================================================================
# 2. VERCEL SCHEDULES / CRON (Segredo para proteger /api/cron/*)
# =============================================================================
# Gere uma string aleatoria longa (minimo 16 caracteres) e configure tambem na Vercel
CRON_SECRET=gere-um-segredo-aleatorio-seguro-com-mais-de-16-caracteres

# =============================================================================
# 3. CONFIGURACOES OPCIONAIS DE RUNTIME
# =============================================================================
# Deixe false na Vercel apos rodar supabase/schema.sql (opcional, default true)
AUTO_CREATE_TABLES=true

# Origens CORS permitidas separadas por virgula (ex: https://meu-app.vercel.app)
CORS_ORIGINS=*

# =============================================================================
# 4. PADROES INICIAIS PARA NOVOS USUARIOS (E-mail SMTP e Taxas de Mercado)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=

CDI_RATE=10.5
SELIC_RATE=13.75
IPCA_RATE=4.5
